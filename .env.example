NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
SESSION_TTL_SECONDS=28800
# Set these only for an explicit first-install bootstrap. Do not commit credentials.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# Required by the existing email/OTP registration feature.
OTP_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
